<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_marino">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/margen"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textColor="@color/blanco"
            android:textSize="@dimen/tam_titulo"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/frase"
            android:textColor="@color/arena"
            android:textSize="@dimen/tam_frase" />

        <Button
            android:id="@+id/botonZarpar"
            android:layout_width="@dimen/ancho_boton"
            android:layout_height="@dimen/alto_boton"
            android:layout_marginTop="@dimen/margen"
            android:background="@drawable/boton_coral"
            android:text="@string/zarpar"
            android:textAllCaps="false"
            android:textColor="@color/blanco"
            android:textSize="@dimen/tam_boton"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/tam_barco"
        android:layout_height="@dimen/tam_barco"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/margen"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_velero" />

</FrameLayout>
